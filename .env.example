# Server
PORT=8082
# 127.0.0.1 if the WAP gateway runs on the same machine,
# 0.0.0.0 if an external gateway has to reach the app
HOST=127.0.0.1

# Optional HTTPS: set both to serve HTTPS on PORT instead of HTTP.
# Renewed certificates are picked up every 12h or on `kill -HUP <pid>`.
#TLS_CERT=/etc/letsencrypt/live/example.org/fullchain.pem
#TLS_KEY=/etc/letsencrypt/live/example.org/privkey.pem

# Authentication (REQUIRED - the app refuses to start with "changeme")
SIGNAL_PASSWORD=changeme

# Your linked Signal number (recommended)
SIGNAL_ACCOUNT=+49170000000
# Optional: path to the signal-cli binary and its data directory
#SIGNAL_CLI=/usr/local/bin/signal-cli
#SIGNAL_CONFIG=/home/signal/.local/share/signal-cli

# Optional tuning
#TZ=Europe/Berlin
#MAX_MESSAGES=50
# Visible characters per page; lower it if the phone says "Response too large"
#TEXT_BUDGET=600
